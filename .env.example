# ============================================================
# FinCare — Environment Configuration Template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=fincare.settings.dev
DJANGO_SECRET_KEY=change-me-in-real-env-min-50-chars-random
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Dubai
DJANGO_LANGUAGE_CODE=en-us

# --- Database (PostgreSQL) ---
# Host port is for connections from Windows; containers use db:5432.
POSTGRES_HOST_PORT=55432
POSTGRES_DB=fincare
POSTGRES_USER=fincare
POSTGRES_PASSWORD=fincare_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://fincare:fincare_dev_password@db:5432/fincare

# --- Redis / Celery ---
# Host port is for connections from Windows; containers use redis:6379.
REDIS_HOST_PORT=56379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MIN=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Local application ports ---
# Django listens on 8000 inside Docker and is published on 8005.
# Next.js will listen on 3000 inside Docker and be published on 3005.
BACKEND_HOST_PORT=8005
FRONTEND_HOST_PORT=3005

# --- CORS / CSRF (Frontend later) ---
CORS_ALLOWED_ORIGINS=http://localhost:3005
CSRF_TRUSTED_ORIGINS=http://localhost:3005

# --- Email (dev: console; prod: SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@fincare.local

# --- Localization (UAE defaults) ---
DEFAULT_CURRENCY=AED
DEFAULT_COUNTRY=AE
FISCAL_YEAR_START_MONTH=1

# --- Storage (Phase 2: S3-compatible) ---
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=me-central-1
AWS_S3_ENDPOINT_URL=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Feature Flags ---
FEATURE_MULTI_ENTITY=True
FEATURE_VAT=True
FEATURE_CORPORATE_TAX=False
FEATURE_FLEET=True
FEATURE_PAYROLL=False
